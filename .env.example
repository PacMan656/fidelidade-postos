# Copie para .env.local (ou .env.production) com os dados do app web do seu projeto Firebase.
# Console Firebase → Configurações do projeto → Seus apps → App da Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise) — recomendado em produção
VITE_RECAPTCHA_SITE_KEY=
# Rede aberta quando o domínio não estiver cadastrado
VITE_DEFAULT_TENANT=dona-rosa
