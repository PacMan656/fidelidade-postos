{
  "name": "fidelidade-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test/unit",
    "test:emulator": "vitest run test/rules test/integration",
    "test": "npm run test:unit",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.15.30",
    "firebase": "12.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
